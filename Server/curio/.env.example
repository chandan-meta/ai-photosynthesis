OPENAI_API_KEY=
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VOICE=Puck
REALTIME_MODEL=gpt-realtime-2.1
TEXT_MODEL=gpt-4.1-mini
CURIO_VOICE=marin
PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:8000
SESSION_SECONDS=180
MAX_ACTIVE_SESSIONS=4
MAX_DAILY_REQUESTS=100
MAX_TURNS=12
MAX_SESSION_TOKENS=12000
# Persistent volume in production. No voice, transcripts or IP addresses stored.
BUDGET_FILE=./usage.json
# Windows/native requests have no Origin. Enable only on a trusted school network/gateway.
ALLOW_NATIVE=false
